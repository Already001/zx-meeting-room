# 会议室助手 LLM（OpenAI 兼容）。复制为 server/.env 后填写，勿提交 .env。
# 启动时由 server/src/index.ts 读取；改完需重启 pnpm dev:server。

# 接口根地址。OpenAI 填 https://api.openai.com（会拼 /v1/chat/completions）。
# 智谱 Coding Plan 填 https://open.bigmodel.cn/api/coding/paas/v4（会拼 /chat/completions，不要再加 /v1）。
MEETING_LLM_BASE_URL=https://api.openai.com

# API Key
MEETING_LLM_API_KEY=

# 默认模型名
MEETING_LLM_MODEL=gpt-4o-mini
